{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/sd-check-edit.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/sd-check-write.py"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/sd-check-shell.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/sd-cache-read-hash.py"
          }
        ]
      }
    ]
  },
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "python .claude/sd-statusline.py"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}

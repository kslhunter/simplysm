{
  "exclude": ["**/dist/**"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "paths": {
      "@simplysm/*": ["./packages/*/src/index.ts"]
    }
  }
}

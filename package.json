{
  "name": "simplysm",
  "version": "14.1.9",
  "description": "심플리즘 패키지",
  "author": "심플리즘",
  "repository": {
    "type": "git",
    "url": "https://github.com/kslhunter/simplysm.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "tests/*",
    "plugins/*"
  ],
  "scripts": {
    "watch": "bun run sd-cli watch",
    "dev": "bun run sd-cli dev",
    "build": "bun run sd-cli build",
    "pub": "bun run sd-cli publish",
    "pub:no-build": "bun run sd-cli publish --no-build",
    "---": "",
    "check": "bun run sd-cli check",
    "typecheck": "bun run sd-cli check --type typecheck",
    "test": "bun run vitest run --configLoader native --reporter=dot --silent=passed-only",
    "lint": "bun run sd-cli check --type lint",
    "----": "",
    "sd-cli": "tsx packages/sd-cli/src/sd-cli.ts",
    "postinstall": "npx -y skills add angular/skills --skill angular-developer -a claude-code -y && playwright-cli install --skills && playwright install chromium"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.14",
    "@types/node": "^24.13.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}

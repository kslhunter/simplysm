{
  "name": "simplysm",
  "version": "14.0.92",
  "description": "심플리즘 패키지",
  "author": "심플리즘",
  "repository": {
    "type": "git",
    "url": "https://github.com/kslhunter/simplysm.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "watch": "pnpm sd-cli watch",
    "dev": "pnpm sd-cli dev",
    "build": "pnpm sd-cli build",
    "pub": "pnpm sd-cli publish",
    "pub:no-build": "pnpm sd-cli --no-build",
    "---": "",
    "check": "pnpm sd-cli check",
    "typecheck": "pnpm sd-cli check --type typecheck",
    "test": "vitest run --reporter=dot --silent=passed-only",
    "lint": "pnpm sd-cli check --type lint",
    "----": "",
    "sd-cli": "tsx packages/sd-cli/src/sd-cli.ts",
    "cc-auth": "node packages/sd-claude/scripts/cli.mjs auth",
    "postinstall": "npx -y skills add angular/skills --skill angular-developer -a claude-code -y && playwright-cli install --skills && playwright install chromium"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.13",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}

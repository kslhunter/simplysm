{
  "name": "simplysm",
  "version": "14.1.16",
  "description": "심플리즘 패키지",
  "author": "심플리즘",
  "repository": {
    "type": "git",
    "url": "https://github.com/kslhunter/simplysm.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "watch": "pnpm sd-cli watch",
    "dev": "pnpm sd-cli dev",
    "build": "pnpm sd-cli build",
    "pub": "pnpm sd-cli publish",
    "pub:no-build": "pnpm sd-cli publish --no-build",
    "---": "",
    "check": "pnpm sd-cli check",
    "typecheck": "pnpm sd-cli check --type typecheck",
    "test": "tsx node_modules/vitest/vitest.mjs run --configLoader native --reporter=dot --silent=passed-only",
    "lint": "pnpm sd-cli check --type lint",
    "----": "",
    "sd-cli": "node --max-old-space-size=8192 --import tsx packages/sd-cli/src/sd-cli.ts",
    "postinstall": "npx -y skills add angular/skills --skill angular-developer -a claude-code -y && playwright-cli install --skills && playwright install chromium"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.15",
    "@simplysm/sd-cli": "workspace:*",
    "@types/node": "^24.13.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "jiti": "^2.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}

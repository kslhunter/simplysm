import {
  ChangeDetectionStrategy,
  Component,
  computed,
  effect,
  inject,
  input,
  signal,
  untracked,
  ViewEncapsulation,
} from "@angular/core";
import { json, obj } from "@simplysm/core-common";
import {
  injectPermsSignal,
  injectViewTypeSignal,
  SdAppStructureProvider,
  SdButton,
  SdCrudDetail,
  SdItemOfTemplate,
  SdPermissionTable,
  SdSharedDataSelect,
  SdToastProvider,
} from "@simplysm/angular";
import { expr } from "@simplysm/orm-common";
import {
  AppAuthProvider,
  AppOrmProvider,
  AppServiceProvider,
  useSharedSignal,
} from "@{{workspaceName}}/client-common";
import { RoleList } from "./role.list";

@Component({
  selector: "app-role-permission-detail",
  changeDetection: ChangeDetectionStrategy.OnPush,
  encapsulation: ViewEncapsulation.None,
  standalone: true,
  imports: [SdCrudDetail, SdPermissionTable, SdSharedDataSelect, SdItemOfTemplate, SdButton],
  template: `
    <sd-crud-detail
      [(ready)]="ready"
      [initialized]="initialized()"
      [(busyCount)]="busyCount"
      [viewType]="viewType()"
      [restricted]="!perms().includes('use')"
      [readonly]="!perms().includes('edit')"
      (submit)="onSubmit()"
    >
      <ng-template #contentTpl>
        <div class="flex-column">
          @if (perms().includes("edit")) {
            <div class="flex-row gap-sm p-sm-default">
              <sd-shared-data-select
                [size]="'sm'"
                [items]="sharedRoles.items()"
                [(value)]="copySourceRoleId"
                [modal]="{ type: RoleList, title: '역할', inputs: { readonly: true } }"
              >
                <ng-template [itemOf]="sharedRoles.items()" let-item="item">
                  \{{ item.name }}
                </ng-template>
              </sd-shared-data-select>
              <sd-button
                [size]="'sm'"
                [inline]="true"
                [disabled]="copySourceRoleId() == null"
                (click)="onImport()"
              >
                가져오기
              </sd-button>
            </div>
          }
          <sd-permission-table
            [items]="permItems()"
            [(value)]="data"
            [disabled]="!perms().includes('edit')"
          />
        </div>
      </ng-template>
    </sd-crud-detail>
  `,
})
export class RolePermissionDetail {
  private readonly _sdToast = inject(SdToastProvider);
  private readonly _appOrm = inject(AppOrmProvider);
  private readonly _appService = inject(AppServiceProvider);
  private readonly _appAuth = inject(AppAuthProvider);
  private readonly _sdAppStructure = inject(SdAppStructureProvider);

  roleId = input.required<number>();

  perms = injectPermsSignal(["master.role-permission"], ["use", "edit"]);
  viewType = injectViewTypeSignal();

  ready = signal(false);
  initialized = signal(false);
  busyCount = signal(0);

  sharedRoles = useSharedSignal("역할");
  copySourceRoleId = signal<number | undefined>(undefined);

  permItems = computed(() =>
    this._sdAppStructure.getPermissionsByStructure(this._sdAppStructure.items()),
  );

  data = signal<Record<string, boolean>>({});
  private _orgData?: Record<string, boolean>;

  constructor() {
    effect(() => {
      this.roleId();

      if (!this.perms().includes("use") || !this.ready()) {
        this.initialized.set(true);
        return;
      }

      void untracked(async () => {
        this.busyCount.update((v) => v + 1);
        await this._sdToast.try(async () => {
          await this._refresh();
        });
        this.busyCount.update((v) => v - 1);
        this.initialized.set(true);
      });
    });
  }

  async onImport(): Promise<void> {
    if (this.busyCount() > 0) return;
    if (!this.perms().includes("edit")) return;

    const sourceId = this.copySourceRoleId();
    if (sourceId == null) return;

    this.busyCount.update((v) => v + 1);
    await this._sdToast.try(async () => {
      const record = await this._loadPermissions(sourceId);
      this.data.set(record);
    });
    this.busyCount.update((v) => v - 1);
  }

  async onSubmit(): Promise<void> {
    if (this.busyCount() > 0) return;
    if (!this.perms().includes("edit")) return;

    const data = this.data();
    if (this._orgData != null && obj.equal(data, this._orgData)) {
      this._sdToast.info("변경사항이 없습니다.");
      return;
    }

    this.busyCount.update((v) => v + 1);
    await this._sdToast.try(async () => {
      const roleId = this.roleId();
      const {{userEntityCamel}}Id = this._appAuth.authInfo()?.{{userEntityCamel}}Id;

      // 권한 동기화: 기존 전체 삭제 후 부여된 권한만 재적재
      await this._appOrm.connectAsync(async (db) => {
        await db
          .rolePermission()
          .where((c) => [expr.eq(c.roleId, roleId)])
          .delete();

        const entries = Object.entries(data).filter(([, v]) => v);
        if (entries.length > 0) {
          await db.rolePermission().insert(
            entries.map(([code, value]) => ({
              roleId,
              code,
              valueJson: json.stringify(value),
            })),
          );
        }

        // 권한 집합 변경 이력은 부모 Role 모델에 단일 적재 (itemId=roleId)
        await db.role().insertDataLog({ action: "수정(권한)", itemId: roleId, {{userEntityCamel}}Id });
      });

      // 해당 역할 세션에 인증정보 변경 통지 → 권한 재로드 (roleId 로 직접 타겟, {{userEntityLabel}} 조회 불필요)
      await this._appService.authInfoChangedEvent.emit((info) => info.roleId === roleId, undefined);

      this._sdToast.success("저장되었습니다.");
      await this._refresh();
    });
    this.busyCount.update((v) => v - 1);
  }

  checkIgnoreChanges(): boolean {
    return (
      this._orgData == null ||
      obj.equal(this.data(), this._orgData) ||
      confirm("변경사항이 있습니다. 무시하고 진행하시겠습니까?")
    );
  }

  private async _refresh(): Promise<void> {
    const record = await this._loadPermissions(this.roleId());
    this.data.set(record);
    this._orgData = obj.clone(record);
  }

  private async _loadPermissions(roleId: number): Promise<Record<string, boolean>> {
    return this._appOrm.connectAsync(async (db) => {
      const rows = await db
        .rolePermission()
        .where((c) => [expr.eq(c.roleId, roleId)])
        .select((c) => ({ code: c.code, valueJson: c.valueJson }))
        .execute();

      const record: Record<string, boolean> = {};
      for (const row of rows) {
        record[row.code] = json.parse(row.valueJson);
      }
      return record;
    });
  }

  protected readonly RoleList = RoleList;
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/check-edit.py\""
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/check-shell.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session-start.py\" --part 0"
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session-start.py\" --part 1"
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session-start.py\" --part 2"
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session-start.py\" --part 3"
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session-start.py\" --part 4 --last"
          }
        ]
      }
    ]
  }
}
